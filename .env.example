# Copy to .env.local (gitignored). Comma-separated hosts that may load the dev server,
# e.g. your laptop's Wi-Fi IP so a phone can open npm run dev:https.
ALLOWED_DEV_ORIGINS=

# Server-only key for POST /api/report (Claude writes the report). Never commit a real value.
# Without it the route returns the deterministic template report.
ANTHROPIC_API_KEY=
